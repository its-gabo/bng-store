# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=bng_store

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# API database connection (must match the Postgres values above)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bng_store

# Outbox worker -> RabbitMQ (must match the RabbitMQ values above)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Email delivery (Mailpit)
EMAIL_FROM=no-reply@bng-store.local
SMTP_HOST=localhost
SMTP_PORT=1025

# Auth
AUTH_SECRET=replace-with-a-long-random-secret

# Web app origin (used for CORS and links in emails)
CORS_ORIGIN=http://localhost:3000

# API
PORT=3001

# Auth sessions, tokens and cookie (defaults shown)
AUTH_SESSION_TTL_HOURS=168
AUTH_EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_COOKIE_NAME=bng_session

# AUTH_COOKIE_SECURE defaults to true when NODE_ENV=production
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# Store (defaults shown)
STORE_PENDING_ORDER_TTL_MINUTES=30
# Cron expression for expiring unpaid orders and renewing subscriptions
STORE_MAINTENANCE_CRON="* * * * *"
STORE_MAINTENANCE_BATCH_SIZE=50
