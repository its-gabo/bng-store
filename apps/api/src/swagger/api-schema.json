        ],
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": [
              "authenticated"
            ],
            "properties": {
              "authenticated": {
                "type": "boolean"
              },
              "user": {
                "type": "object",
                "required": [
                  "id",
                  "email",
                  "name",
                  "emailVerified"
                ],
                "properties": {
                  "id": {
                    "format": "uuid",
                    "type": "string"
                  },
                  "email": {
                    "minLength": 3,
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "emailVerified": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      },
      "GetMyLicenseKeyResponse": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "type": "string"
          },
          "data": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "keyHint",
                  "issuedAt"
                ],
                "properties": {
                  "keyHint": {
                    "type": "string"
                  },
                  "issuedAt": {
                    "format": "date-time",
                    "type": "string"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ListMySubscriptionsResponse": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "status",
                "billingPeriod",
                "bundle",
                "applications",
                "currentPeriodStart",
                "currentPeriodEnd",
                "cancelAtPeriodEnd"
              ],
              "properties": {
                "id": {
                  "format": "uuid",
                  "type": "string"
                },
                "status": {
                  "anyOf": [
                    {
                      "const": "active",
                      "type": "string"
                    },
                    {
                      "const": "cancelled",
                      "type": "string"
                    },
                    {
                      "const": "expired",
                      "type": "string"
                    }
                  ]
                },
                "billingPeriod": {
                  "anyOf": [
                    {
                      "const": "monthly",
                      "type": "string"
                    },
                    {
                      "const": "yearly",
                      "type": "string"
                    }
                  ]
                },
                "bundle": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "id",
                        "name"
                      ],
                      "properties": {
                        "id": {
                          "format": "uuid",
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "applications": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "slug",
                      "name"
                    ],
                    "properties": {
                      "id": {
                        "format": "uuid",
                        "type": "string"
                      },
                      "slug": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    }
                  }
                },
                "currentPeriodStart": {
                  "format": "date-time",
                  "type": "string"
                },
                "currentPeriodEnd": {
                  "format": "date-time",
                  "type": "string"
                },
                "cancelAtPeriodEnd": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      },
      "CancelMySubscriptionResponse": {
        "type": "object",
        "required": [
          "code",
          "message",
          "data"
        ],
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {}
          }
        }
      },
      "StoreSelectionBody": {
        "anyOf": [
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "billingPeriod",
              "bundleId"
            ],
            "properties": {
              "billingPeriod": {
                "anyOf": [
                  {
                    "const": "monthly",
                    "type": "string"
                  },
                  {
                    "const": "yearly",
                    "type": "string"
                  }
                ]
              },
              "bundleId": {
                "format": "uuid",
                "type": "string"
              },
              "extraApplicationIds": {
                "maxItems": 50,
                "type": "array",
                "items": {
                  "format": "uuid",
                  "type": "string"
                }
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "billingPeriod",
              "applicationIds"
