        ],
        "properties": {
          "email": {
            "minLength": 3,
            "format": "email",
            "type": "string"
          },
          "password": {
            "minLength": 8,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "redirectTo": {
            "minLength": 1,
            "maxLength": 2048,
            "format": "safe-redirect-path",
            "type": "string"
          }
        }
      },
      "SignUpEmailResponse": {
        "type": "object",
        "required": [
