        ],
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": [
              "user"
            ],
            "properties": {
              "user": {
                "type": "object",
                "required": [
                  "id",
                  "email",
                  "name",
                  "emailVerified"
                ],
                "properties": {
                  "id": {
                    "format": "uuid",
                    "type": "string"
                  },
                  "email": {
                    "minLength": 3,
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "emailVerified": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      },
      "SignOutResponse": {
        "type": "object",
        "required": [
          "code",
