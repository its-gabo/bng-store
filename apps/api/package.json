{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "dev:worker": "nest start --entryFile worker --watch --path tsconfig.worker.json",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "node dist/worker",
    "lint": "oxlint src/",
    "generate:swagger": "nest build && node dist/swagger/generate-swagger.js",
    "db:generate": "nest build && typeorm migration:generate -d dist/db/data-source.js -p",
    "db:migrate": "nest build && typeorm migration:run -d dist/db/data-source.js",
    "db:revert": "nest build && typeorm migration:revert -d dist/db/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "@sinclair/typebox": "^0.34.52",
    "@workspace/email-templates": "workspace:*",
    "amqplib": "^2.2.0",
    "argon2": "^0.45.1",
    "cookie": "^2.0.1",
    "dotenv": "^18.0.8",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "typescript": "^6.0.2"
  }
}
